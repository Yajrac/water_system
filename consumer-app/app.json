{
  "expo": {
    "name": "PWSS Consumer",
    "slug": "consumer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/consumer-icon.png",
    "scheme": "consumerapp",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/images/consumer-icon.png"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.jaycaber.consumerapp",
      "icon": "./assets/images/consumer-icon.png"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/consumer-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f3f7f9",
          "image": "./assets/images/consumer-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "455b8917-6f83-4432-9f60-5d077e52f0a1"
      }
    }
  }
}
