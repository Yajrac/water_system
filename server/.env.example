# Copy to .env. Commands connect only to this existing database.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=water_system
DB_USER=root
DB_PASSWORD=


PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

JWT_SECRET=
JWT_EXPIRES_IN=15m

# Optional CA certificate for a remote database using TLS.
# Use a dedicated database user with a password on the VPS.
DB_SSL_CA=


# Hidden owner portal for permanent customer deletes (off when blank).
# Generate both with: node scripts/set-owner.js
OWNER_PORTAL_PATH=
OWNER_PASSWORD_HASH=
# Where JSON backups of deleted customers are written (default: server/deleted-backups).
OWNER_BACKUP_DIR=
