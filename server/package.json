{
  "name": "water-system-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:status": "node --env-file=.env scripts/database.js status",
    "db:migrate": "node --env-file=.env scripts/database.js migrate",
    "db:baseline": "node --env-file=.env scripts/database.js baseline",
    "db:seed:office": "node --env-file=.env scripts/database.js seed-office",
    "test": "node --test",
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.0.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
